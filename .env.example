# Aria local development environment
#
# Copy this file to .env at the repository root before running Docker Compose.
# Do not commit real secrets.

# App
APP_ENV=development
APP_VERSION=0.1.0
CORS_ORIGINS=http://localhost:5173

# Database
# Use this value when running the API on your host machine.
# For Docker Compose service-to-service networking, use:
# DATABASE_URL=postgresql://aria:aria@postgres:5432/aria_db
DATABASE_URL=postgresql://aria:aria@localhost:5432/aria_db

# Redis
# Use this value when running the API on your host machine.
# For Docker Compose service-to-service networking, use:
# REDIS_URL=redis://redis:6379/0
REDIS_URL=redis://localhost:6379/0

# Auth
JWT_SECRET=change-me-to-a-long-random-development-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=8

# LLM
ANTHROPIC_API_KEY=replace-with-your-anthropic-api-key
LLM_MODEL=claude-sonnet-4-6
LLM_MAX_TOKENS=4096
# Set to false only for local Docker behind corporate TLS inspection.
SSL_VERIFY=true

# Agent
AGENT_MAX_ITERATIONS=10
AGENT_TIMEOUT_SECONDS=30

# Frontend
VITE_API_URL=http://localhost:8000
