# Backend local development environment
#
# Copy to backend/.env if you run FastAPI from the backend directory.
# If you run Docker Compose from the repository root, copy the root .env.example
# to .env instead.

APP_ENV=development
APP_VERSION=0.1.0
CORS_ORIGINS=http://localhost:5173

DATABASE_URL=postgresql://aria:aria@localhost:5432/aria_db
REDIS_URL=redis://localhost:6379/0

JWT_SECRET=change-me-to-a-long-random-development-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=8

ANTHROPIC_API_KEY=replace-with-your-anthropic-api-key
LLM_MODEL=claude-sonnet-4-6
LLM_MAX_TOKENS=4096

AGENT_MAX_ITERATIONS=10
AGENT_TIMEOUT_SECONDS=30
